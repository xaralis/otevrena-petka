     {
      "name": "deadline",
      "type": "string",
      "description": "Termín (řádek T:)."
     },
     {
      "name": "verbs",
      "type": "string",
      "description": "Rozhodovací slovesa ve znění (schvaluje; bere na vědomí; …), oddělená středníkem."
