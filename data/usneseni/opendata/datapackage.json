      "constraints": {
       "required": true
      }
     },
     {
      "name": "n_nehlasoval",
      "type": "integer",
      "description": "Počet nehlasujících; prázdné, pokud ho zápis neuvádí."
     },
     {
      "name": "n_present",
      "type": "integer",
      "description": "Členů přítomných v okamžiku hlasování (podle prezence a příchodů/odchodů).",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "quorum",
      "type": "integer",
