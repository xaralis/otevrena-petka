 ],
 "description": "Usnesení, hlasování a hlasy členů vytěžené z PDF zápisů. Specifikace: https://github.com/xaralis/usneseni-mo5/blob/main/docs/otevrena-data.md",
 "resources": [
  {
   "name": "meetings",
   "title": "Jednání",
   "description": "Jedno jednání zastupitelstva (ZMO) nebo rady (RMO).",
   "path": "meetings.csv",
   "format": "csv",
   "mediatype": "text/csv",
   "encoding": "utf-8",
   "schema": {
    "fields": [
     {
      "name": "id",
      "type": "string",
      "description": "Identifikátor jednání: <orgán>-<datum>-<číslo jednání>, např. zmo-2025-12-17-20.",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "body",
      "type": "string",
      "description": "Orgán: zmo = zastupitelstvo, rmo = rada.",
      "constraints": {
       "enum": [
        "zmo",
        "rmo"
       ],
       "required": true
      }
     },
     {
      "name": "term",
      "type": "string",
      "description": "Volební období, např. 2022-2026.",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "number",
      "type": "integer",
      "description": "Pořadové číslo jednání v rámci období.",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "kind",
      "type": "string",
      "description": "Druh jednání.",
      "constraints": {
       "enum": [
        "radne",
        "mimoradne",
        "ustavujici"
       ],
       "required": true
      }
     },
     {
      "name": "date",
      "type": "date",
      "description": "Datum jednání.",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "place",
      "type": "string",
      "description": "Místo konání."
     },
     {
      "name": "status",
      "type": "string",
      "description": "ok = zpracování prošlo kontrolami; needs_review = čeká na ruční kontrolu.",
      "constraints": {
       "enum": [
        "ok",
        "needs_review"
       ]
      }
     },
     {
      "name": "source_url",
      "type": "string",
      "description": "URL zdrojového PDF na pardubice.eu.",
      "format": "uri",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "present",
      "type": "string",
      "description": "Přítomní členové (id oddělená středníkem)."
     },
     {
      "name": "excused",
      "type": "string",
      "description": "Omluvení členové (id oddělená středníkem)."
     },
     {
      "name": "absent",
      "type": "string",
      "description": "Neomluveně nepřítomní členové (id oddělená středníkem)."
     }
    ],
    "primaryKey": [
     "id"
    ]
   }
  },
  {
