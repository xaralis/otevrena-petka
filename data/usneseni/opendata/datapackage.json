      "description": "ODVOZENÉ: shrnutí v 1–3 větách."
     },
     {
      "name": "keywords",
      "type": "string",
      "description": "ODVOZENÉ: klíčová slova oddělená středníkem."
     },
     {
      "name": "topics",
      "type": "string",
      "description": "ODVOZENÉ: témata (id z číselníku témat) oddělená středníkem."
